@page "/addclient"
@inject RentalDbContext Db
@using RentalApp.Data
@using RentalApp.Entities
@using Microsoft.EntityFrameworkCore
@using RentalApp.Rabbit
@inject IRabbitMqService _rabbitMqService

<h3 class="title">Add Client</h3>

<form class="form" @onsubmit="AddClient">
    <div class="form-group">
        <label for="name">Name:</label>
        <input id="name" @bind="Name" type="text" placeholder="Enter client name" />
    </div>

    <div class="form-group">
        <label for="contact">Contact:</label>
        <input id="contact" @bind="Contact" type="text" placeholder="Enter contact details" />
    </div>

    <div class="form-group checkbox-group">
        <label>
            <input id="blocked" type="checkbox" @bind="IsBlocked" />
            Blocked
        </label>
    </div>

    <button type="submit" class="btn" disabled="@(!CanAddClient)">Add</button>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="message">@Message</p>
    }
</form>

<h3 class="title">List of Clients</h3>
<table class="client-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Contact</th>
            <th>Blocked?</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Clients)
        {
            <tr>
                <td>@client.Id</td>
                <td>@client.Name</td>
                <td>@client.Contact</td>
                <td>@(client.IsBlocked ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private string Name = string.Empty;
    private string Contact = string.Empty;
    private bool IsBlocked = false;
    private string? Message;
    private List<Client> Clients = new();

    private bool CanAddClient => !string.IsNullOrWhiteSpace(Name) && !string.IsNullOrWhiteSpace(Contact);

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    private async Task AddClient()
    {
        if (!CanAddClient)
        {
            Message = "Please provide the client's name and contact information.";
            return;
        }

        var client = new Client { Name = Name, Contact = Contact, IsBlocked = IsBlocked };
        Db.Clients.Add(client);
        await Db.SaveChangesAsync();

        Message = $"Client with ID {client.Id} has been added.";
        await _rabbitMqService.SendLogAsync(new LogMessage
        {
            Operation = "Add Client",
            UserData = $"Name: {client.Name}, Contact: {client.Contact}, IsBlocked: {client.IsBlocked}"
        });

        await LoadClients();
        Name = Contact = string.Empty;
        IsBlocked = false;
    }

    private async Task LoadClients()
    {
        Clients = await Db.Clients.OrderBy(c => c.Id).ToListAsync();
    }
}