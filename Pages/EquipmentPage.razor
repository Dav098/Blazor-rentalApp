@page "/equipment"
@inject RentalApp.Data.RentalDbContext DbContext
@using RentalApp.Data
@using RentalApp.Entities
@using Microsoft.EntityFrameworkCore
@using RentalApp.Rabbit
@inject IRabbitMqService _rabbitMqService

<h3 class="title">Add Equipment</h3>

<div class="form">

    <div class="form-group">
        <label for="name">Name:</label>
        <input id="name" @bind="newEquipment.Name" type="text" placeholder="Name" />
    </div>

    <div class="form-group">
        <label for="ean">EAN:</label>
        <input id="ean" @bind="newEquipment.EAN" type="text" placeholder="EAN" />
    </div>
    <div class="form-group checkbox-group">
        <label>
            <input type="checkbox" @bind="newEquipment.IsAvailable" /> Available
        </label>
    </div>

    <button class="btn" @onclick="AddEquipment">Add</button>
</div>

<h4 class="title mt-4">List of Equipment</h4>

@if (equipments == null)
{
    <p><em>Loading...</em></p>
}
else if (equipments.Count == 0)
{
    <p>No equipment.</p>
}
else
{
    <table class="equipment-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>EAN</th>
                <th>Available?</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var eq in equipments)
            {
                <tr>
                    <td>@eq.Id</td>
                    <td>@eq.Name</td>
                    <td>@eq.EAN</td>
                    <td>@(eq.IsAvailable ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Equipment> equipments;
    private Equipment newEquipment = new Equipment
    {
        IsAvailable = true 
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadEquipments();
    }

    private async Task LoadEquipments()
    {
        equipments = await DbContext.Equipment.ToListAsync();
    }

    private async Task AddEquipment()
    {
        if (!string.IsNullOrWhiteSpace(newEquipment.Name) && !string.IsNullOrWhiteSpace(newEquipment.EAN))
        {
            DbContext.Equipment.Add(newEquipment);
            await DbContext.SaveChangesAsync();

            
            await _rabbitMqService.SendLogAsync(new LogMessage
            {
                Operation = "Add Equipment",
                UserData = $"Name: {newEquipment.Name}, EAN: {newEquipment.EAN}, IsAvailable: {newEquipment.IsAvailable}"
            });

            newEquipment = new Equipment
            {
                IsAvailable = true
            };

            await LoadEquipments();
        }
    }

}
